# Copy to .env. Blank APP_API_KEY generates data/access-token; never put provider keys in frontend.
APP_API_KEY=
DATABASE_URL=sqlite:///./data/observer.db
DATA_DIR=data
CENTER_LAT=30.0878597
CENTER_LON=31.3413867
RADIUS_M=5000
POLLING_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOMTOM_API_KEY=
AISSTREAM_API_KEY=
OPENAQ_API_KEY=
ASF_BEARER_TOKEN=
COPERNICUS_ACCESS_TOKEN=
CAMERA_ALLOWED_HOSTS=test-streams.mux.dev
# Configure only streams you have explicit permission to use. Sample is media, not a Cairo sensor.
CAMERA_TEST_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
YOLOX_MODEL_PATH=models/yolox_nano.onnx
CAMERA_PROCESSING_ENABLED=false
MQTT_HOST=
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=nile/observations
SERIAL_PORT=
SERIAL_BAUD=115200
SOURCE_PLUGINS=
MAX_DOWNLOAD_BYTES=2000000000
# Optional additions; the original radar center and radius stay unchanged.
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Map Frigate's camera names to existing authorized local camera IDs. No URLs or keys here.
FRIGATE_CAMERA_MAP={}
# Set an exact topic such as frigate/events only for your authorized broker/NVR.
FRIGATE_MQTT_TOPIC=
